---
import {
  IconBrandGithub,
  IconBrandLinkedin,
  IconBrandX,
} from "@tabler/icons-react";
import SectionHeading from "../SectionHeading.astro";
import ContactForm from "../react/ContactForm";
import { site } from "../../data/site";

const icons = {
  github: IconBrandGithub,
  linkedin: IconBrandLinkedin,
  x: IconBrandX,
} as const;
---

<section class="flex flex-col gap-8">
  <SectionHeading id="contact" title="Contact" note="Start a project" />

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
    <div
      class="flex flex-col justify-between gap-10 rounded-3xl p-7 sm:p-9 lg:col-span-5"
      style="background: linear-gradient(155deg, #16337a 0%, #10245a 55%, #0c1c48 100%); color: var(--color-on-navy);"
    >
      <div>
        <p class="display text-[clamp(1.8rem,3vw,2.6rem)]">Let&apos;s build something that lasts.</p>
        <p class="mt-4 max-w-[42ch] text-sm leading-relaxed sm:text-base" style="color: rgb(226 232 255 / 0.85);">
          Tell me what manual work is eating your team&apos;s hours. Every message reaches me
          directly.
        </p>
      </div>
      <div>
        <p class="mb-3 text-xs font-semibold uppercase tracking-[0.14em]" style="color: rgb(226 232 255 / 0.7);">
          Elsewhere
        </p>
        <ul class="flex flex-wrap gap-2">
          {
            site.socials.map((social) => {
              const Icon = icons[social.id];
              return (
                <li>
                  <a
                    href={social.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={social.label}
                    class="flex items-center gap-2 rounded-full border border-white/25 px-4 py-2.5 text-sm font-medium transition-colors duration-300 hover:border-white/60 hover:bg-white/10"
                  >
                    <Icon size={17} stroke={1.7} aria-hidden="true" />
                    <span class="hidden sm:inline">{social.label}</span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>

    <div class="rounded-3xl border border-line bg-white p-7 shadow-soft sm:p-9 lg:col-span-7">
      <ContactForm client:visible />
    </div>
  </div>
</section>
