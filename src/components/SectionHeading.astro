---
interface Props {
  id: string;
  title: string;
  note?: string;
}

const { id, title, note } = Astro.props;
---

<div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
  <h2 id={id} class="display text-[clamp(1.9rem,3.6vw,2.9rem)]">{title}</h2>
  {note && <p class="pb-2 text-sm text-ink-muted sm:pb-3">{note}</p>}
</div>
