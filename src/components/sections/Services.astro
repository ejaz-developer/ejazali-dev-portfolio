---
import {
  IconAppWindow,
  IconRefresh,
  IconRocket,
  IconSettingsAutomation,
} from "@tabler/icons-react";
import SectionHeading from "../SectionHeading.astro";
import { services } from "../../data/site";

const icons = [IconRocket, IconAppWindow, IconSettingsAutomation, IconRefresh];
---

<section class="flex flex-col gap-8">
  <SectionHeading id="services" title="Services" note="What I take on" />

  <div class="overflow-hidden rounded-3xl border border-line bg-white shadow-soft">
    {
      services.map((service, i) => {
        const Icon = icons[i % icons.length];
        return (
          <a
            href="#contact"
            class="group flex flex-col gap-4 border-b border-line px-6 py-7 transition-colors duration-300 last:border-b-0 hover:bg-surface sm:flex-row sm:items-center sm:gap-6 sm:px-8 sm:py-8"
          >
            <span
              class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-navy-wash text-navy transition-colors duration-300 group-hover:bg-navy group-hover:text-on-navy"
              aria-hidden="true"
            >
              <Icon size={24} stroke={1.7} />
            </span>
            <span class="flex flex-1 flex-col gap-1.5">
              <span class="font-heading text-lg font-semibold tracking-tight text-ink sm:text-xl">
                {service.title}
              </span>
              <span class="max-w-[62ch] text-sm leading-relaxed text-ink-muted sm:text-[0.95rem]">
                {service.description}
              </span>
            </span>
            <span
              class="link-arrow hidden shrink-0 text-ink-muted transition-colors duration-300 group-hover:text-navy sm:block"
              aria-hidden="true"
            >
              <svg width="20" height="20" viewBox="0 0 14 14" fill="none">
                <path d="M1 7h11M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.7" />
              </svg>
            </span>
          </a>
        );
      })
    }
  </div>
</section>
