---
import Base from "../layouts/Base.astro";
---

<Base title="Not found">
  <section class="flex flex-col items-start py-28">
    <p class="font-heading text-sm font-semibold tracking-widest text-primary uppercase">404</p>
    <h1 class="mt-3 font-heading text-4xl font-semibold text-foreground sm:text-5xl">
      This page doesn&apos;t exist.
    </h1>
    <a
      href="/"
      class="mt-8 inline-flex h-10 items-center rounded-2xl bg-primary px-6 text-base font-medium text-primary-foreground transition-colors hover:bg-primary/80"
    >
      Back home
    </a>
  </section>
</Base>
