---
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"work">;
  index: number;
}

const { entry, index } = Astro.props;
const { title, description, status, stack, liveUrl } = entry.data;
const href = status === "finished" ? `/work/${entry.id}` : undefined;
const inProgress = status === "in-progress";

const Tag = href ? "a" : "article";

const washes = [
  "linear-gradient(135deg, #e9edf8 0%, #f6f7fa 60%, #dde5f8 100%)",
  "linear-gradient(135deg, #f6f7fa 0%, #e9edf8 55%, #eef1f8 100%)",
  "linear-gradient(135deg, #e4eaf9 0%, #f6f7fa 50%, #e9edf8 100%)",
];
---

<Tag
  {...(href ? { href } : {})}
  class:list={[
    "group card flex flex-col overflow-hidden transition-all duration-300",
    href && "hover:-translate-y-1 hover:shadow-lift",
    !href && "cursor-default",
  ]}
>
  <div
    class="relative flex aspect-[2/1] items-end p-5"
    style={`background: ${washes[index % washes.length]};`}
    aria-hidden="true"
  >
    <span
      class="font-heading text-sm font-semibold tracking-tight text-navy/70"
      >{inProgress ? "In progress" : "Case study"}</span
    >
    {
      (inProgress || liveUrl) && (
        <span class="absolute right-4 top-4">
          {inProgress ? (
            <span class="rounded-full bg-progress-bg px-2.5 py-1 text-xs font-semibold text-progress">
              In progress
            </span>
          ) : (
            <span class="rounded-full bg-live-bg px-2.5 py-1 text-xs font-semibold text-live">
              Live
            </span>
          )}
        </span>
      )
    }
  </div>
  <div class="flex flex-1 flex-col gap-3 p-5 sm:p-6">
    <div class="flex items-start justify-between gap-3">
      <h3 class="font-heading text-xl font-semibold tracking-tight text-ink sm:text-[1.35rem]">
        {title.replace(/^Example — /, "")}
      </h3>
      {
        href && (
          <svg
            width="17"
            height="17"
            viewBox="0 0 14 14"
            fill="none"
            class="mt-1.5 shrink-0 text-ink-muted opacity-0 transition-all duration-300 group-hover:translate-x-1 group-hover:text-navy group-hover:opacity-100"
            aria-hidden="true"
          >
            <path d="M1 7h11M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.7" />
          </svg>
        )
      }
    </div>
    <p class="text-sm leading-relaxed text-ink-muted">{description}</p>
    <ul class="mt-auto flex flex-wrap gap-1.5 pt-3">
      {
        stack.map((tech) => (
          <li class="rounded-full bg-surface px-2.5 py-1 text-[0.7rem] font-medium tracking-wide text-ink-muted uppercase">
            {tech}
          </li>
        ))
      }
    </ul>
  </div>
</Tag>
