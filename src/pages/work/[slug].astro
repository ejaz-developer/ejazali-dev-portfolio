---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export const getStaticPaths = (async () => {
  const entries = (await getCollection("work")).filter(
    (entry) => entry.data.status === "finished"
  );
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { title, description, stack, liveUrl, date } = entry.data;
const { Content } = await render(entry);
const formatted = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
});
---

<Base title={title} description={description}>
  <article class="py-12 sm:py-16">
    <header class="mb-12 flex flex-col gap-6">
      <a
        href="/#work"
        class="link-arrow inline-flex w-fit items-center gap-2 text-sm font-semibold text-navy hover:underline"
      >
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M13 7H3M6 3L2 7l4 4" stroke="currentColor" stroke-width="1.7"></path>
        </svg>
        Back to work
      </a>
      <h1 class="display max-w-[18ch] text-[clamp(2rem,5vw,3.5rem)] text-ink">{title}</h1>
      <p class="max-w-2xl text-lg leading-relaxed text-ink-muted">{description}</p>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
        <span class="text-sm text-ink-muted">{formatted}</span>
        <ul class="flex flex-wrap gap-1.5">
          {
            stack.map((tech) => (
              <li class="rounded-full bg-surface px-3 py-1 text-xs font-medium text-ink-muted">
                {tech}
              </li>
            ))
          }
        </ul>
        {
          liveUrl && (
            <a
              href={liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm font-semibold text-navy underline-offset-4 hover:underline"
            >
              View live ↗
            </a>
          )
        }
      </div>
    </header>
    <div class="prose prose-lg max-w-none">
      <Content />
    </div>
  </article>
</Base>
