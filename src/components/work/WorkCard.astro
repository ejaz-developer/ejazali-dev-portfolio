---
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"work">;
}

const { entry } = Astro.props;
const { title, description, status, stack, liveUrl } = entry.data;
const href = status === "finished" ? `/work/${entry.id}` : undefined;
const inProgress = status === "in-progress";

const Tag = href ? "a" : "article";
---

<Tag
  {...(href ? { href } : {})}
  class:list={[
    "group relative flex flex-col overflow-hidden rounded-3xl border border-border/70 bg-card/80 shadow-card before:pointer-events-none before:absolute before:inset-x-0 before:top-0 before:h-px before:bg-gradient-to-r before:from-transparent before:via-white/10 before:to-transparent transition-all duration-300",
    href
      ? "hover:-translate-y-1 hover:border-primary/40 hover:bg-card hover:shadow-card-hover"
      : "cursor-default",
  ]}
>
  <div
    class="relative flex h-40 items-end bg-gradient-to-br from-deep-space-blue-600 via-deep-space-blue-500 to-deep-space-blue-400 p-4"
  >
    <span class="font-heading text-5xl font-bold text-foreground/15 select-none">
      {title.charAt(0)}
    </span>
    {
      inProgress && (
        <span class="absolute top-3 right-3 rounded-full border border-flag-red-400/40 bg-flag-red-100/80 px-2.5 py-0.5 text-xs font-medium text-flag-red-500">
          In Progress
        </span>
      )
    }
    {
      !inProgress && liveUrl && (
        <span class="absolute top-3 right-3 rounded-full border border-sunflower-gold-400/40 bg-sunflower-gold-100/80 px-2.5 py-0.5 text-xs font-medium text-sunflower-gold-500">
          Live
        </span>
      )
    }
  </div>
  <div class="flex flex-1 flex-col gap-2 p-6">
    <div class="flex items-center justify-between gap-3">
      <h3 class="font-heading text-lg font-semibold text-foreground transition-colors group-hover:text-primary">
        {title}
      </h3>
      {
        href && (
          <span
            class="translate-x-1 text-primary opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100"
            aria-hidden
          >
            →
          </span>
        )
      }
    </div>
    <p class="text-sm leading-relaxed text-muted-foreground">{description}</p>
    <ul class="mt-auto flex flex-wrap gap-1.5 pt-3">
      {
        stack.map((tech) => (
          <li class="rounded-full border border-border bg-background/40 px-2.5 py-0.5 text-xs text-muted-foreground">
            {tech}
          </li>
        ))
      }
    </ul>
  </div>
</Tag>
