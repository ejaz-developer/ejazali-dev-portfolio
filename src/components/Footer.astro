---
import {
  IconBrandGithub,
  IconBrandLinkedin,
  IconBrandX,
} from "@tabler/icons-react";
import { site } from "../data/site";

const icons = {
  github: IconBrandGithub,
  linkedin: IconBrandLinkedin,
  x: IconBrandX,
} as const;

const year = new Date().getFullYear();
---

<footer class="mt-4 border-t border-line">
  <div
    class="mx-auto flex w-full max-w-[80rem] flex-col items-start justify-between gap-6 px-5 py-10 sm:flex-row sm:items-center sm:px-8"
  >
    <div class="flex flex-col gap-1">
      <p class="font-heading text-base font-semibold tracking-tight text-ink">{site.name}</p>
      <p class="text-sm text-ink-muted">© {year} {site.name}. Built with Astro.</p>
    </div>
    <ul class="flex items-center gap-2">
      {
        site.socials.map((social) => {
          const Icon = icons[social.id];
          return (
            <li>
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.label}
                class="flex size-11 items-center justify-center rounded-full border border-line bg-background text-ink-muted transition-all duration-300 hover:-translate-y-0.5 hover:border-navy hover:text-navy hover:shadow-soft"
              >
                <Icon size={18} stroke={1.7} aria-hidden="true" />
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</footer>
