---
import { site } from "../data/site";

const links = [
  { label: "Work", href: "/#work" },
  { label: "Services", href: "/#services" },
  { label: "Contact", href: "/#contact" },
];
---

<header class="sticky top-4 z-50 px-4 sm:px-6">
  <nav
    class="mx-auto flex max-w-3xl items-center justify-between rounded-2xl border border-border bg-card/90 px-4 py-2.5 shadow-soft backdrop-blur-md"
  >
    <a
      href="/"
      class="font-heading text-lg font-semibold tracking-tight text-foreground transition-colors hover:text-primary"
    >
      {site.name}
    </a>
    <ul class="flex items-center gap-1 sm:gap-2">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="rounded-xl px-2.5 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-muted hover:text-foreground sm:px-3"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href="/#contact"
          class="ml-1 inline-flex h-8 items-center rounded-xl bg-primary px-3.5 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/80"
        >
          Hire me
        </a>
      </li>
    </ul>
  </nav>
</header>
