---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import WorkCard from "../../components/work/WorkCard.astro";

const entries = (await getCollection("work")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base title="Work" description="Case studies of web apps and MVPs built by Ejaz.">
  <section class="flex flex-col gap-8 py-12 sm:py-16">
    <SectionHeading id="work" title="Work" note="Case studies" />
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {entries.map((entry, i) => <WorkCard entry={entry} index={i} />)}
    </div>
  </section>
</Base>
