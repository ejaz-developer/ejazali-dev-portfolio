---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<div class="mb-10 flex items-end justify-between gap-4">
  <h2 id={id} class="font-heading text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
    {title}
  </h2>
  <div class="mb-2 hidden h-px flex-1 bg-gradient-to-r from-border via-border/60 to-transparent sm:block"></div>
</div>
