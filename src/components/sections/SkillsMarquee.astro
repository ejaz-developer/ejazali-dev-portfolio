---
import {
  IconBrandMongodb,
  IconBrandNextjs,
  IconBrandReact,
  IconBrandTailwind,
  IconBrandTypescript,
  IconBrandNodejs,
  IconComponents,
  IconRobot,
  IconServer,
} from "@tabler/icons-react";
import { skills } from "../../data/site";

const icons = {
  react: IconBrandReact,
  nextjs: IconBrandNextjs,
  typescript: IconBrandTypescript,
  nodejs: IconBrandNodejs,
  express: IconServer,
  mongodb: IconBrandMongodb,
  tailwind: IconBrandTailwind,
  shadcn: IconComponents,
  agentic: IconRobot,
} as const;

const items = [
  ...skills.map((s) => ({ ...s, Icon: icons[s.icon] })),
  ...skills.map((s) => ({ ...s, Icon: icons[s.icon] })),
];
---

<section aria-label="Toolkit" class="marquee overflow-hidden py-1">
  <div class="marquee-track flex gap-3 pr-3">
    {
      items.map((item, i) => (
        <span class="chip" aria-hidden={i >= skills.length ? "true" : undefined}>
          <item.Icon size={17} stroke={1.7} aria-hidden="true" className="text-navy" />
          {item.label}
        </span>
      ))
    }
  </div>
</section>
