---
import SectionHeading from "../SectionHeading.astro";
import { services } from "../../data/site";
---

<section class="pb-16 sm:pb-20">
  <SectionHeading id="services" title="Services" />
  <div class="grid gap-4 sm:grid-cols-2">
    {
      services.map((service, i) => (
        <article class="group relative rounded-3xl border border-border/70 bg-card/80 p-6 shadow-card before:pointer-events-none before:absolute before:inset-x-0 before:top-0 before:h-px before:bg-gradient-to-r before:from-transparent before:via-white/10 before:to-transparent transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:bg-card hover:shadow-card-hover">
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-2xl bg-secondary font-heading text-sm font-semibold text-secondary-foreground transition-all duration-300 group-hover:scale-110 group-hover:bg-primary group-hover:text-primary-foreground">
            {String(i + 1).padStart(2, "0")}
          </div>
          <h3 class="font-heading text-lg font-semibold text-foreground">{service.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{service.description}</p>
        </article>
      ))
    }
  </div>
</section>
